{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"deny": [
			"Read(.env)",
			"Read(.env.*)",
			"Read(./.env)",
			"Read(./.env.*)",
			"Read(.dev.vars)",
			"Read(.dev.vars.*)",
			"Read(./.dev.vars)",
			"Read(./.dev.vars.*)",

			"Edit(.env)",
			"Edit(.env.*)",
			"Edit(.dev.vars)",
			"Edit(.dev.vars.*)",

			"Write(.env)",
			"Write(.env.*)",
			"Write(.dev.vars)",
			"Write(.dev.vars.*)",

			"Bash(cat .env*)",
			"Bash(cat ./.env*)",
			"Bash(cat .dev.vars*)",
			"Bash(cat ./.dev.vars*)",
			"Bash(head .env*)",
			"Bash(head ./.env*)",
			"Bash(head .dev.vars*)",
			"Bash(head ./.dev.vars*)",
			"Bash(tail .env*)",
			"Bash(tail ./.env*)",
			"Bash(tail .dev.vars*)",
			"Bash(tail ./.dev.vars*)",
			"Bash(less .env*)",
			"Bash(less ./.env*)",
			"Bash(less .dev.vars*)",
			"Bash(less ./.dev.vars*)",
			"Bash(more .env*)",
			"Bash(more ./.env*)",
			"Bash(more .dev.vars*)",
			"Bash(more ./.dev.vars*)",
			"Bash(grep * .env*)",
			"Bash(grep * .dev.vars*)",
			"Bash(awk * .env*)",
			"Bash(awk * .dev.vars*)",
			"Bash(sed * .env*)",
			"Bash(sed * .dev.vars*)",
			"Bash(xxd .env*)",
			"Bash(xxd .dev.vars*)",
			"Bash(strings .env*)",
			"Bash(strings .dev.vars*)",
			"Bash(od .env*)",
			"Bash(od .dev.vars*)",
			"Bash(cp .env*)",
			"Bash(cp .dev.vars*)",
			"Bash(mv .env*)",
			"Bash(mv .dev.vars*)",

			"Bash(wrangler secret put*)",
			"Bash(pnpm wrangler secret put*)",
			"Bash(npx wrangler secret put*)",
			"Bash(pnpm dlx wrangler secret put*)"
		]
	}
}
